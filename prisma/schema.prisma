generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  DISABLED
}

enum PmsProvider {
  MOCK
  REZDY
  INSEANQ
  FAREHARBOR
  BOKUN
  NATIVE
}

enum ConversationControlMode {
  AI
  HUMAN
  PAUSED
}

enum ManualInquiryStatus {
  OPEN
  OPERATOR_NOTIFIED
  CLOSED
}

enum BluePassInquiryStatus {
  DRAFT
  READY_TO_DISPATCH
  OPERATOR_PENDING
  OPERATOR_ACCEPTED
  COUNTER_OFFERED
  DECLINED
  CLOSED
}

enum BluePassLedgerKind {
  CREATOR_COMMISSION_ESTIMATE
  BLUEPASS_PLATFORM_COMMISSION
  CONSERVATION_ALLOCATION
  PAYMENT_PROCESSING_ALLOCATION
  OPERATOR_PAYOUT_PLACEHOLDER
}

enum BluePassLedgerStatus {
  PENDING
  FINALIZED
  VOIDED
}

enum BluePassPaymentIntentStatus {
  PENDING
  SUCCEEDED
  FAILED
  EXPIRED
}

enum BluePassOperatorPayoutStatus {
  PENDING_RELEASE
  TRANSFERRED
  FAILED
}

enum BluePassOperatorDispatchStatus {
  QUEUED
  SENT
  FAILED
}

// Lifecycle for a direct-PMS (e.g. Rezdy) booking paid through BluePass's own Stripe checkout,
// instead of the operator's own PMS-native payment (e.g. RezdyPay). Distinct from
// BluePassInquiryStatus: there is no operator-negotiation step here - the operator's own PMS is
// the source of truth for availability, BluePass only collects payment and confirms the hold.
enum PmsBookingPaymentAttemptStatus {
  AWAITING_PAYMENT
  PAID_AWAITING_CONFIRM
  CONFIRMED
  PAYMENT_FAILED
  CONFIRM_FAILED_REFUNDED
  REFUND_FAILED
  // Reachable only from CONFIRMED - the trip has happened (or was manually marked as such by an
  // admin) and the operator's OPERATOR_PAYOUT_PLACEHOLDER ledger entry has been released. Added
  // 2026-08-06: before this, nothing in the schema represented "trip completed," so settlement had
  // no trigger at all - see settledAt below and PmsBookingOperatorPayout.
  SETTLED
  // Milestone 3 (payment-settlement plan): reachable only from CONFIRMED - cancelled/refunded before
  // the trip sailed and before settlement paid the operator, so per PAYMENT_ARCHITECTURE.md the
  // refund is clean (funds were still held, no operator clawback needed). A CONFIRMED booking ends
  // up as either SETTLED (trip happened) or this (it didn't) - never both. Added 2026-08-10.
  CANCELLED_REFUNDED
}

model Tenant {
  id              String              @id @default(cuid())
  slug            String              @unique
  name            String
  status          TenantStatus        @default(ACTIVE)
  widgetPublicKey String              @unique
  allowedOrigins  String[]
  defaultLocale   String              @default("en")
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  branding        TenantBranding?
  config          TenantConfig?
  integrations    TenantIntegration[]
  conversations   Conversation[]
  manualInquiries ManualInquiry[]
}

model TenantBranding {
  id             String   @id @default(cuid())
  tenantId       String   @unique
  logoUrl        String?
  primaryColor   String
  widgetTitle    String
  welcomeMessage String
  brandVoice     String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model TenantConfig {
  id                    String      @id @default(cuid())
  tenantId              String      @unique
  supportedChannels     String[]
  enabledFeatures       String[]
  requiredSlots         Json
  bookingMode           String
  bookingWriteEnabled   Boolean     @default(false)
  pmsProvider           PmsProvider @default(MOCK)
  publicProductCatalog  Json        @default("[]")
  operatorKnowledgePack Json        @default("{}")
  escalationRules       String[]
  responseGuardrails    String[]
  // Operator's own ops/admin WhatsApp number, e.g. for a direct-PMS booking payment-confirm
  // failure alert. Falls back to a per-tenant env var when unset (see resolveTenantAdminWhatsAppPhone).
  adminWhatsAppPhone    String?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  tenant                Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model TenantIntegration {
  id                   String      @id @default(cuid())
  tenantId             String
  provider             PmsProvider
  encryptedCredentials String
  status               String
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, provider])
}

model Conversation {
  id            String                  @id @default(cuid())
  tenantId      String
  controlMode   ConversationControlMode @default(AI)
  channel       String
  travellerId   String?
  leadId        String?
  // E.164 digits (no "+") - set for WhatsApp-channel conversations so the webhook can find the
  // thread for an inbound sender, and so a Business-app human-takeover can be toggled per number.
  whatsappPhone String?
  // First-touch referral attribution, captured off the widget message payload's `referral` field
  // (see /api/widget/messages/route.ts) the first time it's present and these are still null -
  // durable per-conversation so it survives to checkout time regardless of how many turns later a
  // booking actually happens. Region-agnostic on purpose: the marketplace/Indonesia flow already
  // consumes body.referral per-message and doesn't need these, but the generic booking flow (AU/
  // Boattime etc.) has nowhere else to read attribution from at checkout-creation time.
  referralPartnerId String?
  referralLinkId    String?
  referralCode      String?
  referralRole      String?
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  tenant          Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  messages        Message[]
  bookingState    ConversationBookingState?
  manualInquiries ManualInquiry[]

  @@unique([tenantId, whatsappPhone])
}

model Message {
  id             String   @id @default(cuid())
  tenantId       String
  conversationId String
  role           String
  content        String
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([tenantId, conversationId, createdAt])
}

model ConversationBookingState {
  id                  String   @id @default(cuid())
  tenantId            String
  conversationId      String   @unique
  productExternalId   String?
  productTitle        String?
  dateText            String?
  guests              Int?
  travellerName       String?
  travellerEmail      String?
  travellerPhone      String?
  bookingStatus       String   @default("DRAFT")
  confirmationSummary String?
  externalBookingId   String?
  externalProvider    String?
  bookingError        String?
  timeOptions         Json?
  ticketOptions       Json?
  ticketQuantities    Json?
  extraOptions        Json?
  extraQuantities     Json?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([tenantId, conversationId])
}

model ManualInquiry {
  id                String              @id @default(cuid())
  tenantId          String
  conversationId    String
  status            ManualInquiryStatus @default(OPEN)
  productExternalId String?
  productTitle      String?
  dateText          String?
  guests            Int?
  travellerName     String?
  travellerEmail    String?
  travellerPhone    String?
  travellerMessage  String
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([tenantId, status, createdAt])
  @@index([tenantId, conversationId, createdAt])
}

model BluePassInquiry {
  id                String                @id @default(cuid())
  tenantId          String
  conversationId    String
  status            BluePassInquiryStatus @default(DRAFT)
  sourceChannel     String                @default("WEB_WIDGET")
  travellerName     String?
  travellerEmail    String?
  travellerPhone    String?
  destination       String?
  tripType          String?
  dateWindow        String?
  guests            Int?
  budget            String?
  interests         Json?
  selectedYachtSlug String?
  selectedYachtName String?
  operatorId        String?
  operatorName      String?
  operatorPhone     String?
  notes             String?
  travellerMessage  String
  referralPartnerId String?
  referralLinkId    String?
  referralCode      String?
  referralRole      String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  events         BluePassInquiryEvent[]
  ledger         BluePassLedgerEntry[]
  dispatches     BluePassOperatorDispatch[]
  paymentIntents BluePassPaymentIntent[]

  @@index([tenantId, conversationId, status, createdAt])
  @@index([tenantId, status, createdAt])
}

model BluePassInquiryEvent {
  id                String   @id @default(cuid())
  tenantId          String
  conversationId    String
  bluePassInquiryId String
  type              String
  fromStatus        String?
  toStatus          String?
  metadata          Json?
  createdAt         DateTime @default(now())

  inquiry BluePassInquiry @relation(fields: [bluePassInquiryId], references: [id], onDelete: Cascade)

  @@index([tenantId, conversationId, createdAt])
  @@index([bluePassInquiryId, createdAt])
}

model BluePassLedgerEntry {
  id                String               @id @default(cuid())
  tenantId          String
  conversationId    String
  bluePassInquiryId String
  kind              BluePassLedgerKind
  amountCents       Int
  currency          String               @default("USD")
  status            BluePassLedgerStatus @default(PENDING)
  referralPartnerId String?
  referralLinkId    String?
  referralCode      String?
  referralRole      String?
  metadata          Json?
  finalizedAt       DateTime?
  voidedAt          DateTime?
  voidReason        String?
  paidOutAt         DateTime?
  paidOutReference  String?
  paidOutBy         String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  inquiry BluePassInquiry         @relation(fields: [bluePassInquiryId], references: [id], onDelete: Cascade)
  payout  BluePassOperatorPayout?

  @@index([tenantId, conversationId, status, createdAt])
  @@index([bluePassInquiryId, status])
}

// Guest checkout on BluePass's own Stripe account (never the operator's PMS) - one row per
// checkout attempt. stripePaymentIntentId is only populated once Stripe actually creates the
// PaymentIntent behind the Checkout Session (may briefly be null right after creation).
model BluePassPaymentIntent {
  id                      String                      @id @default(cuid())
  tenantId                String
  bluePassInquiryId       String
  stripeCheckoutSessionId String                      @unique
  stripePaymentIntentId   String?                     @unique
  amountCents             Int
  currency                String
  status                  BluePassPaymentIntentStatus @default(PENDING)
  createdAt               DateTime                    @default(now())
  updatedAt               DateTime                    @updatedAt

  inquiry BluePassInquiry @relation(fields: [bluePassInquiryId], references: [id], onDelete: Cascade)

  @@index([tenantId, bluePassInquiryId])
  @@index([status])
}

// A real Stripe transfer of one FINALIZED ledger entry's operator-net share to that operator's own
// Stripe Connect account, gated behind an admin's explicit release action (see
// releaseBluePassLedgerEntryPayoutViaStripe). stripeConnectAccountId is admin-supplied at release
// time (same manual-trust model as markBluePassLedgerEntryPaid's paidOutReference) rather than
// looked up automatically - kai has no first-party link to bluepass-app's OperatorProfile rows.
model BluePassOperatorPayout {
  id                     String                       @id @default(cuid())
  tenantId               String
  bluePassLedgerEntryId  String                       @unique
  stripeConnectAccountId String
  stripeTransferId       String?                      @unique
  amountCents            Int
  currency               String
  status                 BluePassOperatorPayoutStatus @default(PENDING_RELEASE)
  releasedBy             String?
  releasedAt             DateTime?
  failureReason          String?
  createdAt              DateTime                     @default(now())
  updatedAt              DateTime                     @updatedAt

  ledgerEntry BluePassLedgerEntry @relation(fields: [bluePassLedgerEntryId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
}

model BluePassOperatorDispatch {
  id                String                         @id @default(cuid())
  tenantId          String
  conversationId    String
  bluePassInquiryId String
  status            BluePassOperatorDispatchStatus @default(QUEUED)
  operatorId        String?
  operatorName      String?
  operatorPhone     String
  outboundText      String
  providerMessageId String?
  failureReason     String?
  metadata          Json?
  sentAt            DateTime?
  createdAt         DateTime                       @default(now())
  updatedAt         DateTime                       @updatedAt

  inquiry BluePassInquiry @relation(fields: [bluePassInquiryId], references: [id], onDelete: Cascade)

  @@index([tenantId, conversationId, status, createdAt])
  @@index([bluePassInquiryId, createdAt])
}

// One row per BluePass-Stripe checkout attempt against a real PMS (Rezdy today) booking - the
// durable, append-only record ConversationBookingState cannot be, since that row is a single
// mutable per-conversation cache overwritten on every turn. Deliberately NOT tied to
// BluePassInquiry: this flow has no operator-negotiation lifecycle - the operator's own PMS owns
// availability, BluePass just collects payment and confirms the hold.
model PmsBookingPaymentAttempt {
  id                      String                         @id @default(cuid())
  tenantId                String
  conversationId          String
  pmsProvider             PmsProvider
  productExternalId       String
  productTitle            String
  dateText                String
  guests                  Int
  travellerName           String
  travellerEmail          String
  travellerPhone          String?
  ticketQuantities        Json?
  extraQuantities         Json?
  grossAmountCents        Int
  currency                String
  externalBookingId       String
  stripeCheckoutSessionId String                         @unique
  stripePaymentIntentId   String?                        @unique
  stripeRefundId          String?
  // Copied from Conversation.referral* at checkout-creation time (see
  // createBluePassCheckoutSessionForPmsBooking) - frozen at that point so a later change to the
  // conversation's attribution never rewrites the economics of an already-created attempt.
  referralPartnerId       String?
  referralLinkId          String?
  referralCode            String?
  referralRole            String?
  status                  PmsBookingPaymentAttemptStatus @default(AWAITING_PAYMENT)
  failureReason           String?
  adminAlertSentAt        DateTime?
  // Set when this attempt transitions CONFIRMED -> SETTLED (see the enum comment). Null until then.
  settledAt               DateTime?
  // Milestone 3 (payment-settlement plan): set together when this attempt transitions CONFIRMED ->
  // CANCELLED_REFUNDED. cancelledBy is "CUSTOMER" | "OPERATOR" | "ADMIN" (plain String, matching the
  // paidOutBy/releasedBy "who" convention elsewhere in this schema, not a new enum). refundTierPercent
  // is 0-100, the tier actually applied (operator-initiated cancellations always record 100 - see
  // cancelPmsBookingPaymentAttempt). refundAmountCents is the real amount Stripe refunded.
  cancelledAt             DateTime?
  cancelledBy             String?
  cancellationReason      String?
  refundTierPercent       Int?
  refundAmountCents       Int?
  createdAt               DateTime                       @default(now())
  updatedAt               DateTime                       @updatedAt

  ledgerEntries PmsBookingLedgerEntry[]

  @@index([tenantId, conversationId, createdAt])
  @@index([status])
}

// Commission/conservation split for a confirmed PmsBookingPaymentAttempt, reusing the same
// BluePassLedgerKind/BluePassLedgerStatus enums and calculateBluePassLedgerSplit math as the
// BluePass-marketplace flow. Created once, directly FINALIZED, only at confirm-success - the
// gross amount here is exact (real ticket prices), unlike the marketplace's parsed-budget estimates.
model PmsBookingLedgerEntry {
  id                         String               @id @default(cuid())
  tenantId                   String
  conversationId             String
  pmsBookingPaymentAttemptId String
  kind                       BluePassLedgerKind
  amountCents                Int
  currency                   String
  status                     BluePassLedgerStatus @default(PENDING)
  referralPartnerId          String?
  referralLinkId             String?
  referralCode               String?
  referralRole               String?
  metadata                   Json?
  finalizedAt                DateTime?
  voidedAt                   DateTime?
  voidReason                 String?
  paidOutAt                  DateTime?
  paidOutReference           String?
  paidOutBy                  String?
  createdAt                  DateTime             @default(now())
  updatedAt                  DateTime             @updatedAt

  attempt PmsBookingPaymentAttempt  @relation(fields: [pmsBookingPaymentAttemptId], references: [id], onDelete: Cascade)
  payout  PmsBookingOperatorPayout?

  @@index([tenantId, conversationId, status, createdAt])
  @@index([pmsBookingPaymentAttemptId, status])
}

// Direct-PMS/Rezdy flow's equivalent of BluePassOperatorPayout (the marketplace flow's payout
// record) - added 2026-08-06 because PmsBookingLedgerEntry had no payout-release path at all before
// this: Boattime/Rezdy bookings could only be "paid" via the manual paidOutReference attestation on
// the ledger entry itself, never a real Stripe transfer. Mirrors BluePassOperatorPayout's shape and
// status semantics exactly (see releaseBluePassLedgerEntryPayoutViaStripe in bluepass-stripe.ts,
// and its new PmsBookingLedgerEntry sibling) - a separate model, not a generalized shared one,
// because BluePassLedgerEntry and PmsBookingLedgerEntry are themselves separate models with no
// common parent to hang a single payout table off safely.
model PmsBookingOperatorPayout {
  id                      String                       @id @default(cuid())
  tenantId                String
  pmsBookingLedgerEntryId String                       @unique
  stripeConnectAccountId  String
  stripeTransferId        String?                      @unique
  amountCents             Int
  currency                String
  status                  BluePassOperatorPayoutStatus @default(PENDING_RELEASE)
  releasedBy              String?
  releasedAt              DateTime?
  failureReason           String?
  createdAt               DateTime                     @default(now())
  updatedAt               DateTime                     @updatedAt

  ledgerEntry PmsBookingLedgerEntry @relation(fields: [pmsBookingLedgerEntryId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
}

enum CronRunStatus {
  SUCCESS
  PARTIAL
  FAILURE
}

// Milestone 3.5 (BOOKING_INTEGRATION_PLAN.md's "per-platform monitoring: availability freshness,
// booking-write failures, cancellations sync") - one row per cron job execution, written by the
// cron route itself (see /api/cron/settle-pms-bookings) so a job that silently stops running or
// starts failing leaves a queryable trail instead of nobody noticing until an operator complains
// about a missed payout. `summary` is whatever structured result the job's own function already
// returns (e.g. runSettlementSweep's {checked, settled, skipped}) - not re-derived, just persisted.
model CronRunLog {
  id           String        @id @default(cuid())
  jobName      String
  status       CronRunStatus
  summary      Json?
  errorMessage String?
  startedAt    DateTime
  finishedAt   DateTime      @default(now())

  @@index([jobName, finishedAt])
}

// One row per LLM (Groq/OpenAI) call - router or polish. Written best-effort from
// src/server/llm/bluepass-llm-usage.ts so a logging failure never breaks the actual reply.
// tenantName is a display string, not a hard relation: the router has no tenant context today
// (BluePass-only), and the polish layer only carries a tenant display name, not a tenant id.
model LlmUsageEvent {
  id               String   @id @default(cuid())
  callType         String
  provider         String
  model            String
  tenantName       String?
  promptTokens     Int
  completionTokens Int
  totalTokens      Int
  estimatedCostUsd Float?
  createdAt        DateTime @default(now())

  @@index([createdAt])
  @@index([tenantName, createdAt])
  @@index([callType, createdAt])
}
